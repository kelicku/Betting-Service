# ── 必須（本番） ─────────────────────────────────────
ENV=production
PUBLIC_BASE_URL=https://hoshifuru.example.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# 32 文字以上のランダム値: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 配送先の暗号化鍵: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ※ 紛失すると保存済みの配送先を復号できなくなる。安全に保管すること
PII_ENCRYPTION_KEY=
COOKIE_SECURE=true
# PUBLIC_BASE_URL 以外に操作を受け付けるアクセス元（カンマ区切り・任意）
# ALLOWED_ORIGINS=https://old.hoshifuru.example.com
# COOKIE_DOMAIN=hoshifuru.example.com

# ── Redis（レート制限の共有。未設定ならプロセス内メモリ） ─────────
REDIS_URL=redis://HOST:6379/0

# ── メール送信（SMTP 互換サービス：Amazon SES / SendGrid 等） ────────
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=星降る宝物殿 <no-reply@hoshifuru.example.com>

# ── オブジェクトストレージ（S3 互換） ───────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=hoshifuru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-1
S3_PUBLIC_BASE_URL=https://cdn.hoshifuru.example.com

# ── エラー監視 ──────────────────────────────────────
SENTRY_DSN=

# ── 広告・アンケート事業者（事業者ごとに設定） ───────────────────
ENABLE_MOCK_OFFERS=false
POSTBACK_MAX_SKEW_SECONDS=600
POSTBACK_SECRET_ADNETWORK=
POSTBACK_IPS_ADNETWORK=
POSTBACK_SECRET_SURVEYHUB=
POSTBACK_IPS_SURVEYHUB=
