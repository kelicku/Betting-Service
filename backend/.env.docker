# docker compose 用の開発設定（本番では使用しないこと）
ENV=development
PUBLIC_BASE_URL=http://localhost:3300
DATABASE_URL=postgresql+asyncpg://gacha:gacha@db:5432/gacha
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-insecure-secret-change-me-in-production
MAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/uploads
ENABLE_MOCK_OFFERS=true
# デモ用ワンクリックログイン（開発・デモ環境のみ。ENV=production では無効）
DEMO_LOGIN_ENABLED=true
