# ─────────────────────────────────────────────────────────────
# 本番用のバックエンド設定の雛形（このファイルをコピーして backend.env を作り、値を埋める）
#   cp deploy/backend.env.example deploy/backend.env
# backend.env には秘密情報が入るため、Git に登録しないこと（.gitignore 済み）。
# 【必須】は空のままだと起動しない／正しく動かない項目。
# ─────────────────────────────────────────────────────────────

# 【必須】本番モード（デモ用ログイン・模擬の広告成果は自動で無効になる）
ENV=production
# 【必須】公開 URL（末尾の / なし）。メール内のリンクと、操作を受け付けるアクセス元の確認に使う
PUBLIC_BASE_URL=https://example.com

# 【必須】データベース（PostgreSQL 16）。docker-compose.prod.yml の db を使う場合は下の値のまま（パスワードは DB_PASSWORD と同じに）
DATABASE_URL=postgresql+asyncpg://gacha:CHANGE_ME_DB_PASSWORD@db:5432/gacha
# DB の接続数：「台数 × ワーカー数 × (POOL_SIZE + MAX_OVERFLOW)」< DB の最大接続数 − 20（docs/hosting-proposal.md）
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
WEB_CONCURRENCY=2
# Redis（レート制限をワーカー・サーバー間で共有）
REDIS_URL=redis://redis:6379/0

# 【必須】秘密鍵（32 文字以上のランダムな値）。作り方：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 【必須】配送先・ギフトコードの暗号化鍵。作り方：python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ※ 一度決めたら変えないこと（変えると保存済みの住所・ギフトコードが読めなくなる）。安全な場所に控えを保管する
PII_ENCRYPTION_KEY=
# 【必須】HTTPS で公開するため true
COOKIE_SECURE=true

# 【必須】メール送信（確認メール・パスワード再設定・ギフトコードのお知らせ）
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=わくわくガチャ <no-reply@example.com>
# 問い合わせ・障害の通知先（任意）
OPS_NOTIFY_EMAIL=

# SMS 認証（Twilio）。使う場合は twilio にして下の 3 項目を設定し、管理画面の「SMS 認証を必須にする」を有効にする
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 送信元番号（+1… など）か Messaging Service の SID のどちらか
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# 画像の保存先。local はサーバーの uploads ボリュームに保存（1 台構成向け）。2 台以上・CDN を使う場合は s3
STORAGE_BACKEND=local
# S3 互換ストレージを使う場合
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-1
S3_PUBLIC_BASE_URL=

# 広告・アンケート事業者の成果通知の署名鍵（事業者ごとに POSTBACK_SECRET_<事業者名>）
# POSTBACK_SECRET_SKYFLAG=

# デジコの自動発行（契約後に設定。未設定の間はギフトコード在庫・手動発行で運用）
DIGICO_API_BASE_URL=
DIGICO_API_KEY=

# エラー監視（任意）
SENTRY_DSN=

# 本番では必ず無効（ENV=production なら設定に関わらず無効になる）
DEMO_LOGIN_ENABLED=false
ENABLE_MOCK_OFFERS=false
